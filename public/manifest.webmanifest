    },
    {
      "name": "Reports",
      "short_name": "Reports",
      "description": "Open care reports",
      "url": "/dashboard?tab=reports",
      "icons": [{ "src": "/favicon.svg", "sizes": "any", "type": "image/svg+xml" }]
    }
  ],
  "icons": [
